+// The conditions of continuous effects, checked at fixed points of the game (every
+// adjustment) in id order: an effect whose condition holds again starts applying
+// anew and gets a new id (effect::is_available). The lazy evaluations in between
+// change nothing, so the ids do not depend on which checks happened to ask, e.g.
+// for hidden cards.
+void field::refresh_effect_conditions() {
+	if(pduel->querying || core.refreshing_condition)
+		return;
+	std::vector<effect*> conditional;
+	auto add = [&](const effect_container& effs) {
+		for(const auto& it : effs) {
+			if(it.second->condition)
+				conditional.push_back(it.second);
+		}
+	};
+	add(effects.aura_effect);
+	for(auto* pcard : pduel->cards) {
+		add(pcard->single_effect);
+		add(pcard->field_effect);
+		// (equip, target and material effects only while they apply to a card: their
+		// conditions may assume one, e.g. GetEquipTarget(); the game evaluates them
+		// only then too)
+		if(pcard->equiping_target)
+			add(pcard->equip_effect);
+		if(!pcard->effect_target_cards.empty())
+			add(pcard->target_effect);
+		if(pcard->overlay_target)
+			add(pcard->xmaterial_effect);
+	}
+	std::sort(conditional.begin(), conditional.end(), effect_sort_id);
+	conditional.erase(std::unique(conditional.begin(), conditional.end()), conditional.end());
+	for(auto* peffect : conditional) {
+		core.refreshing_condition = peffect;
+		peffect->is_available();
