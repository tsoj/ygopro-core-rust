+bool card::card_public_sort(card* c1, card* c2) {
+	if(card_operation_sort(c1, c2))
+		return true;
+	if(card_operation_sort(c2, c1))
+		return false;
+	// (materials of Xyz monsters that went to different places, where they have
+	// the same sequence, e.g. one to the GY and one to the Extra Deck)
+	if((c1->current.location & LOCATION_OVERLAY) && (c2->current.location & LOCATION_OVERLAY)
+		&& c1->overlay_target && c2->overlay_target
+		&& c1->overlay_target->current.location != c2->overlay_target->current.location)
+		return c1->overlay_target->current.location < c2->overlay_target->current.location;
+	return c1->cardid < c2->cardid;
+}
+card_vector card::public_order(const card_set& cset) {
+	card_vector cv(cset.begin(), cset.end());
